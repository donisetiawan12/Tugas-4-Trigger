    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const zone = 'Asia/Jakarta';\n\nconst rawDate = String($json['Scheduled Date'] ?? '').trim();\nconst rawTime = String($json['Scheduled Time'] ?? '').trim();\n\nif (!rawDate || !rawTime) {\n  return {\n    json: {\n      ...$json,\n      is_due: false,\n      schedule_error: 'Scheduled Date atau Scheduled Time kosong'\n    }\n  };\n}\n\nconst date = DateTime.fromFormat(rawDate, 'dd/MM/yyyy', { zone });\n\nif (!date.isValid) {\n  return {\n    json: {\n      ...$json,\n      is_due: false,\n      schedule_error: `Format tanggal tidak valid: ${rawDate}`\n    }\n  };\n}\n\nlet time = DateTime.fromFormat(rawTime, 'H:mm:ss', { zone });\n\nif (!time.isValid) {\n  time = DateTime.fromFormat(rawTime, 'HH:mm:ss', { zone });\n}\n\nif (!time.isValid) {\n  time = DateTime.fromFormat(rawTime, 'H:mm', { zone });\n}\n\nif (!time.isValid) {\n  time = DateTime.fromFormat(rawTime, 'HH:mm', { zone });\n}\n\nif (!time.isValid) {\n  return {\n    json: {\n      ...$json,\n      is_due: false,\n      schedule_error: `Format waktu tidak valid: ${rawTime}`\n    }\n  };\n}\n\nconst scheduled = date.set({\n  hour: time.hour,\n  minute: time.minute,\n  second: time.second,\n  millisecond: 0\n});\n\nconst now = DateTime.now().setZone(zone);\n\nreturn {\n  json: {\n    ...$json,\n    is_due: scheduled.toMillis() <= now.toMillis(),\n    schedule_error: null,\n    scheduled_time_jakarta: scheduled.toISO(),\n    checked_at_jakarta: now.toISO()\n  }\n};"
      },
